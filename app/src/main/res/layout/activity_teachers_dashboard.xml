<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ui2"
    tools:context=".TeachersDashboard">
    <ImageView
        android:id="@+id/profilePicTeacher"
        android:padding="10dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/zainahmed"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:foreground="@drawable/frame"
        />

    <ImageView
        android:id="@+id/notification_icon"
        android:padding="10dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_notifications"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        />

    <TextView
        android:id="@+id/welcome_text"
        android:text="@string/welcome"
        android:textColor="@android:color/white"
        android:fontFamily="@font/roboto"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="4dp"
        android:layout_toRightOf="@id/profilePicTeacher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/teachers_name"
        android:text="Teacher"
        android:textColor="@android:color/white"
        android:fontFamily="@font/roboto_bold"
        android:layout_marginStart="4dp"
        android:textSize="18sp"
        android:layout_toRightOf="@id/profilePicTeacher"
        android:layout_below="@id/welcome_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/teachers_card"
        android:layout_alignParentStart="true"
        android:layout_marginTop="82dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:rippleColor="@color/colorPrimary"
        app:cardCornerRadius="14dp"
        android:clickable="true"
        android:focusable="true"
        android:checkable="true"
        android:background="@drawable/myshadow"
        app:cardElevation="8dp"
        >

        <TextView
            android:id="@+id/total_students_teacher"
            android:text="Total Students:"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="25dp"
            android:fontFamily="@font/roboto_bold"
            android:padding="8dp"
            android:layout_marginStart="12dp"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/img_student"
            android:layout_width="160dp"
            android:layout_height="150dp"
            android:layout_gravity="right|center"
            android:contentDescription="@string/student_image"
            android:src="@drawable/book_lover" />

        <Button
            android:id="@+id/btn_sign_up"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="65dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:text="Interact with student or the class"
            android:fontFamily="@font/roboto_bold"
            android:padding="4dp"
            android:textSize="10sp" />
        <Button
            android:id="@+id/btn_attendance_and_performance_teacher"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="110dp"
            android:layout_marginEnd="16dp"
            android:text="@string/student_attendance_and_performance"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:fontFamily="@font/roboto_bold"
            android:padding="4dp"
            android:textSize="10sp"/>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="154dp"
        android:layout_below="@+id/teachers_card"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/assign_lesson_card"
            android:layout_width="114dp"
            android:layout_height="114dp"
            android:layout_below="@+id/teachers_card"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="14dp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            app:rippleColor="@color/colorPrimary"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/asign_lesson_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:src="@drawable/task" />
            <TextView
                android:id="@+id/asign_lesson_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/assign_lesson_card"
                android:layout_gravity="bottom|center"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:text="@string/assign_lesson"
                android:layout_marginBottom="4dp"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/conduct_online_exam_card"
            android:layout_width="114dp"
            android:layout_height="114dp"
            android:layout_below="@+id/teachers_card"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="14dp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            app:rippleColor="@color/colorPrimary"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/conduct_online_exam_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:src="@drawable/mydocumet" />

            <TextView
                android:id="@+id/conduct_online_exam_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/assign_lesson_card"
                android:layout_gravity="bottom|center"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/roboto_bold"
                android:padding="2.4dp"
                android:text="@string/online_exam"
                android:textAlignment="center"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/track_student_attendance"
            android:layout_width="114dp"
            android:layout_height="114dp"
            android:layout_below="@+id/teachers_card"
            android:layout_marginStart="6dp"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="14dp"
            android:clickable="true"
            android:focusable="true"
            android:checkable="true"
            app:rippleColor="@color/colorPrimary"
            app:cardElevation="8dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:src="@drawable/attendance" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/assign_lesson_card"
                android:layout_gravity="bottom|center"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:text="@string/student_attendance"
                android:textAlignment="center"
                android:layout_marginBottom="4dp"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/teacher_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:elevation="8dp"
        android:layout_alignParentBottom="true"
        app:itemRippleColor="@color/colorPrimary"
        app:menu="@menu/bottom_nav_admin" />
</RelativeLayout>